# Copy to .env and replace the example secrets.
INTERFACE_MODE=api
API_KEY=replace_with_a_long_random_key
READ_ONLY_API_KEY=replace_with_a_read_only_key_for_public_mygpt
API_PUBLIC_URL=https://biwenger-mcp.cestmail.com
DATABASE_URL=sqlite:///data/biwenger.db
BIWENGER_COMPETITION_SLUG=world-cup
REQUIRE_WRITE_CONFIRMATION=true
DEFAULT_SQUAD_SIZE=11
DEFAULT_USER_ID=default_user
ENABLE_DAILY_SYNC=true
